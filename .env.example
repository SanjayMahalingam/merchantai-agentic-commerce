# Server Configuration
PORT=3000
NODE_ENV=development

# Razorpay Test Credentials (get these from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_SECRET_HERE

# Cashfree Test Credentials (get these from https://merchant.cashfree.com/merchants/signup or Developers section)
CASHFREE_APP_ID=cf_test_YOUR_APP_ID_HERE
CASHFREE_SECRET_KEY=cf_test_YOUR_SECRET_KEY_HERE
CASHFREE_ENV=sandbox

# Optional: Anthropic API Key (for LLM-powered natural language query parsing)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
